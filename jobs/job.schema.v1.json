{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blink.v3/schemas/job.schema.v1.json",
  "title": "Blink v3 Job Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_version",
    "meta",
    "target",
    "crawl",
    "ignore",
    "content",
    "link_check",
    "schedule",
    "slack",
    "features"
  ],
  "properties": {
    "job_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "name", "enabled"],
      "properties": {
        "job_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "default": "" },
        "enabled": { "type": "boolean" },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url", "allowed_domains"],
      "properties": {
        "base_url": { "type": "string", "format": "uri" },
        "allowed_domains": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "start_urls": {
          "type": "array",
          "items": { "type": "string", "format": "uri" },
          "default": []
        },
        "follow_subdomains": { "type": "boolean", "default": false }
      }
    },
    "crawl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "render_mode",
        "user_agent",
        "request_delay_seconds",
        "max_pages_per_run",
        "max_depth",
        "parse_querystring",
        "parse_fragments",
        "timeouts",
        "retry_count",
        "max_response_bytes",
        "concurrency"
      ],
      "properties": {
        "render_mode": {
          "type": "string",
          "enum": ["playwright"]
        },
        "user_agent": { "type": "string", "minLength": 1 },
        "request_delay_seconds": { "type": "number", "minimum": 0 },
        "max_pages_per_run": { "type": "integer", "minimum": 0 },
        "max_depth": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "parse_querystring": { "type": "boolean" },
        "parse_fragments": { "type": "boolean" },
        "timeouts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "navigation_seconds",
            "network_idle_seconds",
            "playwright_wait_seconds"
          ],
          "properties": {
            "navigation_seconds": { "type": "integer", "minimum": 1 },
            "network_idle_seconds": { "type": "integer", "minimum": 1 },
            "playwright_wait_seconds": { "type": "integer", "minimum": 1 }
          }
        },
        "retry_count": { "type": "integer", "minimum": 0, "maximum": 10 },
        "max_response_bytes": { "type": "integer", "minimum": 1024 },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 16 },
        "browser": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "viewport",
            "locale",
            "timezone_id",
            "extra_http_headers",
            "storage_state_path",
            "persist_storage_state",
            "headless",
            "block_request_netloc_contains"
          ],
          "properties": {
            "viewport": {
              "type": "object",
              "additionalProperties": false,
              "required": ["width", "height"],
              "properties": {
                "width": { "type": "integer", "minimum": 320 },
                "height": { "type": "integer", "minimum": 200 }
              }
            },
            "locale": { "type": "string", "minLength": 1 },
            "timezone_id": { "type": "string", "minLength": 1 },
            "extra_http_headers": {
              "type": "object",
              "additionalProperties": { "type": "string" },
              "default": {}
            },
            "storage_state_path": {
              "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
            },
            "persist_storage_state": { "type": "boolean" },
            "headless": { "type": "boolean" },
            "block_request_netloc_contains": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "default": []
            }
          }
        },
        "observability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "log_console",
            "log_non_2xx_responses",
            "log_request_failures",
            "save_failure_screenshot",
            "save_failure_html"
          ],
          "properties": {
            "log_console": { "type": "boolean" },
            "log_non_2xx_responses": { "type": "boolean" },
            "log_request_failures": { "type": "boolean" },
            "save_failure_screenshot": { "type": "boolean" },
            "save_failure_html": { "type": "boolean" }
          }
        }
      }
    },
    "ignore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "http_status",
        "url_schemes",
        "netloc_contains",
        "path_contains",
        "path_extensions",
        "fragment_contains"
      ],
      "properties": {
        "http_status": {
          "type": "array",
          "items": { "type": "integer", "minimum": 100, "maximum": 999 },
          "default": []
        },
        "url_schemes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "netloc_contains": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "path_contains": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "path_extensions": {
          "type": "array",
          "items": { "type": "string", "pattern": "^\\." },
          "default": []
        },
        "fragment_contains": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["history_keep", "extract_main_text", "store_rendered_html"],
      "properties": {
        "history_keep": { "type": "integer", "minimum": 1 },
        "extract_main_text": { "type": "boolean" },
        "store_rendered_html": { "type": "boolean" },
        "main_text_extractor": {
          "type": "string",
          "enum": ["regex", "trafilatura"],
          "default": "trafilatura"
        },
        "significant_change_threshold_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 25
        },
        "text_compare_max_chars": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 2000000,
          "default": 100000
        }
      }
    },
    "link_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "request_timeout_seconds",
        "retry_count",
        "consecutive_failures_before_alert",
        "follow_redirects",
        "write_json_report"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "request_timeout_seconds": { "type": "integer", "minimum": 1 },
        "retry_count": { "type": "integer", "minimum": 0, "maximum": 10 },
        "consecutive_failures_before_alert": {
          "type": "integer",
          "minimum": 1
        },
        "follow_redirects": { "type": "boolean" },
        "write_json_report": { "type": "boolean", "default": false }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone",
        "overlap_policy",
        "crawl",
        "link_check",
        "maintenance_windows"
      ],
      "properties": {
        "timezone": { "type": "string", "minLength": 1 },
        "overlap_policy": {
          "type": "string",
          "enum": ["skip", "queue", "replace"]
        },
        "crawl": { "$ref": "#/$defs/scheduleTask" },
        "link_check": { "$ref": "#/$defs/scheduleTask" },
        "maintenance_windows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "cron"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "cron": { "type": "string", "minLength": 1 }
            }
          },
          "default": []
        }
      }
    },
    "slack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "channel_id", "webhook_env", "bot_token_env", "reminders"],
      "properties": {
        "enabled": { "type": "boolean" },
        "channel_id": { "type": "string", "default": "" },
        "webhook_env": { "type": "string", "default": "BLINK_SLACK_WEBHOOK_URL" },
        "bot_token_env": { "type": "string", "default": "BLINK_SLACK_BOT_TOKEN" },
        "emoji_actions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ignore", "claim"],
          "properties": {
            "ignore": { "type": "string", "default": "x" },
            "claim": { "type": "string", "default": "eyes" }
          }
        },
        "reminders": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "days_after_first_alert"],
          "properties": {
            "enabled": { "type": "boolean" },
            "days_after_first_alert": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_counters", "netlocs_counted"],
      "properties": {
        "ref_counters": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "netlocs_counted": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    }
  },
  "$defs": {
    "scheduleTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mode",
        "expression",
        "jitter_seconds",
        "max_runtime_seconds",
        "startup_delay_seconds"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "type": "string", "enum": ["interval", "cron"] },
        "expression": { "type": "string", "minLength": 1 },
        "jitter_seconds": { "type": "integer", "minimum": 0 },
        "max_runtime_seconds": { "type": "integer", "minimum": 1 },
        "startup_delay_seconds": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
