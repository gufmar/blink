{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blink.v3/schemas/job.schema.v1.json",
  "title": "Blink v3 Job Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_version",
    "meta",
    "target",
    "crawl",
    "content",
    "link_check",
    "schedule",
    "notifications",
    "features"
  ],
  "properties": {
    "job_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "name", "enabled"],
      "properties": {
        "job_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "default": "" },
        "enabled": { "type": "boolean" },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url", "allowed_domains"],
      "properties": {
        "base_url": { "type": "string", "format": "uri" },
        "allowed_domains": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "start_urls": {
          "type": "array",
          "items": { "type": "string", "format": "uri" },
          "default": []
        },
        "follow_subdomains": { "type": "boolean", "default": false }
      }
    },
    "crawl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "render_mode",
        "user_agent",
        "request_delay_seconds",
        "max_pages_per_run",
        "max_depth",
        "url_normalization",
        "timeouts",
        "retry_count",
        "max_response_bytes",
        "concurrency",
        "ignore"
      ],
      "properties": {
        "render_mode": {
          "type": "string",
          "enum": ["playwright"]
        },
        "user_agent": { "type": "string", "minLength": 1 },
        "request_delay_seconds": { "type": "number", "minimum": 0 },
        "max_pages_per_run": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum pages per crawl run; 0 means no explicit page limit (still bounded by max_depth, frontier, and optional runtime limits)."
        },
        "max_depth": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "url_normalization": { "$ref": "#/$defs/crawlUrlNormalization" },
        "timeouts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "navigation_seconds",
            "network_idle_seconds",
            "playwright_wait_seconds"
          ],
          "properties": {
            "navigation_seconds": { "type": "integer", "minimum": 1 },
            "network_idle_seconds": { "type": "integer", "minimum": 1 },
            "playwright_wait_seconds": { "type": "integer", "minimum": 1 }
          }
        },
        "retry_count": { "type": "integer", "minimum": 0, "maximum": 10 },
        "max_response_bytes": { "type": "integer", "minimum": 1024 },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 16 },
        "ignore": { "$ref": "#/$defs/urlIgnore" },
        "browser": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "viewport",
            "locale",
            "timezone_id",
            "extra_http_headers",
            "storage_state_path",
            "persist_storage_state",
            "headless",
            "block_request_netloc_contains"
          ],
          "properties": {
            "viewport": {
              "type": "object",
              "additionalProperties": false,
              "required": ["width", "height"],
              "properties": {
                "width": { "type": "integer", "minimum": 320 },
                "height": { "type": "integer", "minimum": 200 }
              }
            },
            "locale": { "type": "string", "minLength": 1 },
            "timezone_id": { "type": "string", "minLength": 1 },
            "extra_http_headers": {
              "type": "object",
              "additionalProperties": { "type": "string" },
              "default": {}
            },
            "storage_state_path": {
              "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
            },
            "persist_storage_state": { "type": "boolean" },
            "headless": { "type": "boolean" },
            "block_request_netloc_contains": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "default": []
            }
          }
        },
        "observability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "log_console",
            "log_non_2xx_responses",
            "log_request_failures",
            "save_failure_screenshot",
            "save_failure_html"
          ],
          "properties": {
            "log_console": { "type": "boolean" },
            "log_non_2xx_responses": { "type": "boolean" },
            "log_request_failures": { "type": "boolean" },
            "save_failure_screenshot": { "type": "boolean" },
            "save_failure_html": { "type": "boolean" }
          }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["history_keep", "extract_main_text", "store_rendered_html"],
      "properties": {
        "history_keep": { "type": "integer", "minimum": 1 },
        "extract_main_text": { "type": "boolean" },
        "store_rendered_html": { "type": "boolean" },
        "main_text_extractor": {
          "type": "string",
          "enum": ["regex", "trafilatura"],
          "default": "trafilatura"
        },
        "significant_change_threshold_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 25
        },
        "text_compare_max_chars": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 2000000,
          "default": 100000
        }
      }
    },
    "link_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "implementation",
        "request_timeout_seconds",
        "retry_count",
        "consecutive_failures_before_alert",
        "ignore",
        "target_url_policy",
        "follow_redirects",
        "playwright",
        "preflight",
        "hybrid",
        "write_json_report",
        "save_failure_screenshot",
        "tolerance"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "implementation": {
          "type": "string",
          "enum": ["playwright", "http", "http_then_playwright"],
          "default": "playwright"
        },
        "request_timeout_seconds": { "type": "integer", "minimum": 1 },
        "retry_count": { "type": "integer", "minimum": 0, "maximum": 10 },
        "consecutive_failures_before_alert": {
          "type": "integer",
          "minimum": 1
        },
        "ignore": { "$ref": "#/$defs/linkCheckIgnore" },
        "target_url_policy": { "$ref": "#/$defs/linkCheckTargetUrlPolicy" },
        "follow_redirects": { "type": "boolean" },
        "playwright": { "$ref": "#/$defs/linkCheckPlaywright" },
        "preflight": { "$ref": "#/$defs/linkCheckPreflight" },
        "hybrid": { "$ref": "#/$defs/linkCheckHybrid" },
        "write_json_report": { "type": "boolean", "default": false },
        "save_failure_screenshot": { "type": "boolean", "default": true },
        "tolerance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["by_category"],
          "properties": {
            "by_category": {
              "type": "object",
              "additionalProperties": false,
              "required": ["client", "server", "timeout", "connection", "other"],
              "properties": {
                "client": { "$ref": "#/$defs/toleranceRule" },
                "server": { "$ref": "#/$defs/toleranceRule" },
                "timeout": { "$ref": "#/$defs/toleranceRule" },
                "connection": { "$ref": "#/$defs/toleranceRule" },
                "other": { "$ref": "#/$defs/toleranceRule" }
              }
            }
          }
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone",
        "overlap_policy",
        "crawl",
        "link_check",
        "maintenance_windows"
      ],
      "properties": {
        "timezone": { "type": "string", "minLength": 1 },
        "overlap_policy": {
          "type": "string",
          "enum": ["skip", "queue", "replace"]
        },
        "crawl": { "$ref": "#/$defs/scheduleTask" },
        "link_check": { "$ref": "#/$defs/scheduleTask" },
        "maintenance_windows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "cron"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "cron": { "type": "string", "minLength": 1 }
            }
          },
          "default": []
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "max_blinks_per_run", "crawl_summary_on_run", "destinations"],
      "properties": {
        "enabled": { "type": "boolean" },
        "max_blinks_per_run": { "type": "integer", "minimum": 1, "default": 1 },
        "crawl_summary_on_run": { "type": "boolean", "default": false },
        "slack_signing_secret_env": {
          "type": "string",
          "minLength": 1,
          "default": "BLINK_SLACK_SIGNING_SECRET"
        },
        "destinations": {
          "type": "array",
          "items": { "$ref": "#/$defs/notificationDestination" },
          "default": []
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_counters", "netlocs_counted"],
      "properties": {
        "ref_counters": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "netlocs_counted": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    }
  },
  "$defs": {
    "urlIgnore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url_schemes",
        "netloc_contains",
        "path_contains",
        "path_extensions",
        "fragment_contains"
      ],
      "properties": {
        "url_schemes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "netloc_contains": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "path_contains": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "path_extensions": {
          "type": "array",
          "items": { "type": "string", "pattern": "^\\." },
          "default": []
        },
        "fragment_contains": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        }
      }
    },
    "crawlUrlNormalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["internal", "external"],
      "properties": {
        "internal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["keep_query", "keep_fragment"],
          "properties": {
            "keep_query": { "type": "boolean" },
            "keep_fragment": { "type": "boolean" }
          }
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "required": ["store_raw_href"],
          "properties": {
            "store_raw_href": { "type": "boolean" }
          }
        }
      }
    },
    "linkCheckPlaywright": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "navigation_timeout_seconds",
        "network_idle_seconds",
        "settle_wait_seconds",
        "wait_until",
        "accept_partial_success_on_navigation_timeout"
      ],
      "properties": {
        "navigation_timeout_seconds": { "type": "integer", "minimum": 1 },
        "network_idle_seconds": { "type": "integer", "minimum": 0 },
        "settle_wait_seconds": { "type": "integer", "minimum": 0 },
        "wait_until": {
          "type": "string",
          "enum": ["commit", "domcontentloaded"],
          "default": "commit"
        },
        "accept_partial_success_on_navigation_timeout": {
          "type": "boolean",
          "default": true
        },
        "restart_browser_every_n_checks": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "After this many completed Playwright link checks, close and reopen the browser (0 = disabled)."
        }
      }
    },
    "linkCheckPreflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "skip_playwright_content_types",
        "skip_playwright_path_extensions"
      ],
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "skip_playwright_content_types": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "skip_playwright_path_extensions": {
          "type": "array",
          "items": { "type": "string", "pattern": "^\\." },
          "default": []
        }
      }
    },
    "linkCheckHybrid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retry_playwright_http_status",
        "retry_playwright_on_connection_error",
        "run_playwright_when_preflight_html",
        "run_playwright_when_http_ok_unknown_type"
      ],
      "properties": {
        "retry_playwright_http_status": {
          "type": "array",
          "items": { "type": "integer", "minimum": 100, "maximum": 599 },
          "default": [403, 429, 503]
        },
        "retry_playwright_on_connection_error": {
          "type": "boolean",
          "default": false
        },
        "run_playwright_when_preflight_html": {
          "type": "boolean",
          "default": true
        },
        "run_playwright_when_http_ok_unknown_type": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "linkCheckIgnore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url_schemes",
        "http_status",
        "error_category",
        "error_message_contains",
        "target_netloc_contains",
        "target_domain_equals"
      ],
      "properties": {
        "url_schemes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "http_status": {
          "type": "array",
          "items": { "type": "integer", "minimum": 100, "maximum": 999 },
          "default": []
        },
        "error_category": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["client", "server", "timeout", "connection", "other"]
          },
          "default": []
        },
        "error_message_contains": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "target_netloc_contains": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "target_domain_equals": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        }
      }
    },
    "linkCheckTargetUrlPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "request", "reporting"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["external_raw"]
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["keep_query", "keep_fragment"],
          "properties": {
            "keep_query": { "type": "boolean" },
            "keep_fragment": { "type": "boolean" }
          }
        },
        "reporting": {
          "type": "object",
          "additionalProperties": false,
          "required": ["show_fragment"],
          "properties": {
            "show_fragment": { "type": "boolean" }
          }
        }
      }
    },
    "toleranceRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_consecutive_failures", "min_age_days"],
      "properties": {
        "min_consecutive_failures": { "type": "integer", "minimum": 1 },
        "min_age_days": { "type": "integer", "minimum": 0 }
      }
    },
    "scheduleTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mode",
        "expression",
        "jitter_seconds",
        "max_runtime_seconds",
        "startup_delay_seconds"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "type": "string", "enum": ["interval", "cron"] },
        "expression": { "type": "string", "minLength": 1 },
        "jitter_seconds": { "type": "integer", "minimum": 0 },
        "max_runtime_seconds": { "type": "integer", "minimum": 1 },
        "startup_delay_seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "notificationDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "enabled",
        "channel_id",
        "webhook_env",
        "bot_token_env",
        "action_aliases",
        "reminders"
      ],
      "properties": {
        "type": { "type": "string", "enum": ["slack"] },
        "id": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "channel_id": { "type": "string", "default": "" },
        "webhook_env": { "type": "string", "default": "BLINK_SLACK_WEBHOOK_URL" },
        "bot_token_env": { "type": "string", "default": "BLINK_SLACK_BOT_TOKEN" },
        "action_aliases": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ignore", "claim", "on_hold", "resolve", "retest"],
          "properties": {
            "ignore": { "type": "string", "default": "x" },
            "claim": { "type": "string", "default": "eyes" },
            "on_hold": { "type": "string", "default": "pause_button" },
            "resolve": { "type": "string", "default": "white_check_mark" },
            "retest": { "type": "string", "default": "curly_loop" }
          }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "post_alerts_via_bot": { "type": "boolean", "default": true },
            "on_hold_default_days": { "type": "integer", "minimum": 1, "default": 7 },
            "on_hold_max_days": { "type": "integer", "minimum": 1, "default": 90 },
            "ignore_default_days": { "type": "integer", "minimum": 1, "default": 30 },
            "ignore_allow_infinite": { "type": "boolean", "default": true }
          }
        },
        "reminders": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "days_after_first_alert"],
          "properties": {
            "enabled": { "type": "boolean" },
            "days_after_first_alert": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supports_threads",
            "supports_reactions",
            "supports_interactive_components"
          ],
          "properties": {
            "supports_threads": { "type": "boolean" },
            "supports_reactions": { "type": "boolean" },
            "supports_interactive_components": { "type": "boolean" }
          }
        }
      }
    }
  }
}
