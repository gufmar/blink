{
  "job_version": 1,
  "meta": {
    "job_id": "example.org",
    "name": "Example Website",
    "description": "Default template for Blink v3 jobs.",
    "enabled": true,
    "tags": []
  },
  "target": {
    "base_url": "https://example.org",
    "allowed_domains": [
      "example.org"
    ],
    "start_urls": [],
    "follow_subdomains": false
  },
  "crawl": {
    "render_mode": "playwright",
    "user_agent": "Blink/3.0",
    "request_delay_seconds": 1.0,
    "max_pages_per_run": 0,
    "max_depth": null,
    "url_normalization": {
      "internal": {
        "keep_query": false,
        "keep_fragment": true
      },
      "external": {
        "store_raw_href": true
      }
    },
    "timeouts": {
      "navigation_seconds": 20,
      "network_idle_seconds": 4,
      "playwright_wait_seconds": 5
    },
    "retry_count": 2,
    "max_response_bytes": 2000000,
    "concurrency": 1,
    "ignore": {
      "url_schemes": [
        "mailto",
        "ftp",
        "tel",
        "javascript"
      ],
      "netloc_contains": [
        "localhost",
        "google-analytics.com",
        "youtube-nocookie.com",
        "linkedin.com",
        "discord.gg",
        "youtu.be",
        "youtube.com",
        "twitter.com",
        "x.com"
      ],
      "path_contains": [],
      "path_extensions": [
        ".avi",
        ".webm",
        ".flv",
        ".mkv",
        ".wmv",
        ".mov",
        ".iso"
      ],
      "fragment_contains": []
    },
    "browser": {
      "viewport": {
        "width": 1366,
        "height": 768
      },
      "locale": "en-US",
      "timezone_id": "UTC",
      "extra_http_headers": {},
      "storage_state_path": null,
      "persist_storage_state": false,
      "headless": true,
      "block_request_netloc_contains": [
        "google-analytics.com",
        "googletagmanager.com",
        "google.com",
        "googleapis.com"
      ]
    },
    "observability": {
      "log_console": false,
      "log_non_2xx_responses": true,
      "log_request_failures": true,
      "save_failure_screenshot": true,
      "save_failure_html": false
    }
  },
  "content": {
    "history_keep": 5,
    "extract_main_text": true,
    "store_rendered_html": false,
    "main_text_extractor": "trafilatura",
    "significant_change_threshold_percent": 25,
    "text_compare_max_chars": 100000
  },
  "link_check": {
    "enabled": true,
    "implementation": "playwright",
    "request_timeout_seconds": 10,
    "retry_count": 1,
    "consecutive_failures_before_alert": 2,
    "ignore": {
      "url_schemes": [
        "mailto",
        "tel",
        "javascript",
        "ftp"
      ],
      "http_status": [
        400,
        403,
        429,
        999
      ],
      "error_category": [],
      "error_message_contains": [],
      "target_netloc_contains": [],
      "target_domain_equals": []
    },
    "target_url_policy": {
      "source": "external_raw",
      "request": {
        "keep_query": true,
        "keep_fragment": true
      },
      "reporting": {
        "show_fragment": true
      }
    },
    "follow_redirects": true,
    "playwright": {
      "navigation_timeout_seconds": 10,
      "network_idle_seconds": 4,
      "settle_wait_seconds": 2,
      "wait_until": "commit",
      "accept_partial_success_on_navigation_timeout": true,
      "restart_browser_every_n_checks": 500
    },
    "preflight": {
      "enabled": true,
      "skip_playwright_content_types": [
        "application/zip",
        "application/x-zip-compressed",
        "application/octet-stream",
        "application/pdf",
        "application/x-tar",
        "application/gzip"
      ],
      "skip_playwright_path_extensions": [
        ".zip",
        ".pdf",
        ".tar",
        ".gz",
        ".tgz"
      ]
    },
    "hybrid": {
      "retry_playwright_http_status": [
        403,
        429,
        503
      ],
      "retry_playwright_on_connection_error": false,
      "run_playwright_when_preflight_html": true,
      "run_playwright_when_http_ok_unknown_type": false
    },
    "write_json_report": true,
    "save_failure_screenshot": false,
    "tolerance": {
      "by_category": {
        "client": {
          "min_consecutive_failures": 1,
          "min_age_days": 0
        },
        "server": {
          "min_consecutive_failures": 2,
          "min_age_days": 2
        },
        "timeout": {
          "min_consecutive_failures": 2,
          "min_age_days": 2
        },
        "connection": {
          "min_consecutive_failures": 2,
          "min_age_days": 2
        },
        "other": {
          "min_consecutive_failures": 1,
          "min_age_days": 0
        }
      }
    }
  },
  "schedule": {
    "timezone": "UTC",
    "overlap_policy": "skip",
    "crawl": {
      "enabled": true,
      "mode": "interval",
      "expression": "24h",
      "jitter_seconds": 45,
      "max_runtime_seconds": 7200,
      "startup_delay_seconds": 15
    },
    "link_check": {
      "enabled": true,
      "mode": "interval",
      "expression": "6h",
      "jitter_seconds": 30,
      "max_runtime_seconds": 3600,
      "startup_delay_seconds": 30
    },
    "maintenance_windows": []
  },
  "notifications": {
    "enabled": false,
    "max_blinks_per_run": 1,
    "crawl_summary_on_run": false,
    "destinations": [
      {
        "type": "slack",
        "id": "slack-default",
        "enabled": false,
        "channel_id": "",
        "webhook_env": "BLINK_SLACK_WEBHOOK_URL",
        "bot_token_env": "BLINK_SLACK_BOT_TOKEN",
        "action_aliases": {
          "ignore": "see_no_evil",
          "claim": "bust_in_silhouette",
          "on_hold": "double_vertical_bar",
          "resolve": "white_check_mark",
          "retest": "curly_loop"
        },
        "lifecycle": {
          "enabled": false,
          "post_alerts_via_bot": true,
          "on_hold_default_days": 7,
          "on_hold_max_days": 90,
          "ignore_default_days": 30,
          "ignore_allow_infinite": true
        },
        "reminders": {
          "enabled": true,
          "days_after_first_alert": [
            3,
            7,
            14
          ]
        },
        "capabilities": {
          "supports_threads": true,
          "supports_reactions": true,
          "supports_interactive_components": true
        }
      }
    ]
  },
  "features": {
    "ref_counters": [],
    "netlocs_counted": []
  }
}